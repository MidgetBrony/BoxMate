<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BoxMate.ManifestSourcesWindow"
        Width="620" Height="500" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#10131A"
        Title="Manage mod sources" Icon="/Assets/BoxMate.ico">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel>
      <TextBlock Text="MOD SOURCES" FontSize="22" FontWeight="Bold" Foreground="#70D6B2" />
      <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#94A0B5"
                 Text="The official BOXROOM catalogue is always included. Add other GitHub repositories here; BoxMate finds manifest.json automatically." />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,20,0,14" ColumnDefinitions="*,Auto">
      <TextBox x:Name="SourceInput" PlaceholderText="MidgetBrony/Boxroom-Plus or a GitHub repository link"
               KeyDown="SourceInput_OnKeyDown" />
      <Button Grid.Column="1" Content="Add" Margin="10,0,0,0" Padding="22,8" Click="AddButton_OnClick" />
    </Grid>

    <Border Grid.Row="2" Background="#191E29" CornerRadius="10" Padding="10">
      <Grid RowDefinitions="*,Auto">
        <ListBox x:Name="SourcesList" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*" Margin="6">
                <Border Width="30" Height="30" CornerRadius="15" Background="#273142">
                  <Path Width="17" Height="17" Stretch="Uniform" Fill="#94A0B5"
                        Data="M12,2 C6.48,2 2,6.58 2,12.22 C2,16.73 4.87,20.55 8.84,21.9 C9.34,22 9.52,21.68 9.52,21.41 L9.51,19.5 C6.73,20.12 6.14,18.29 6.14,18.29 C5.68,17.11 5.03,16.8 5.03,16.8 C4.12,16.16 5.1,16.17 5.1,16.17 C6.1,16.24 6.63,17.22 6.63,17.22 C7.52,18.78 8.97,18.33 9.54,18.07 C9.63,17.4 9.89,16.94 10.17,16.68 C7.95,16.42 5.62,15.55 5.62,11.64 C5.62,10.53 6,9.62 6.65,8.91 C6.55,8.65 6.22,7.62 6.75,6.22 C6.75,6.22 7.59,5.95 9.5,7.26 C10.3,7.03 11.15,6.91 12,6.91 C12.85,6.91 13.7,7.03 14.5,7.26 C16.41,5.95 17.25,6.22 17.25,6.22 C17.78,7.62 17.45,8.65 17.35,8.91 C18,9.62 18.38,10.53 18.38,11.64 C18.38,15.56 16.04,16.42 13.81,16.68 C14.17,17 14.49,17.63 14.49,18.59 L14.48,21.41 C14.48,21.68 14.66,22.01 15.17,21.9 C19.13,20.54 22,16.73 22,12.22 C22,6.58 17.52,2 12,2 Z" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="15" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="DialogStatus" Grid.Row="1" Foreground="#E99A9A" Margin="6,8,6,2" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,18,0,0" ColumnDefinitions="Auto,*,Auto,Auto">
      <Button Content="Remove selected" Click="RemoveButton_OnClick" />
      <Button Grid.Column="2" Content="Cancel" Margin="0,0,10,0" Click="CancelButton_OnClick" />
      <Button Grid.Column="3" Content="Save" Padding="24,8" Click="SaveButton_OnClick" />
    </Grid>
  </Grid>
</Window>
